# Database (PostgreSQL / RDS)
DATABASE_URL=postgresql://user:pass@host:5432/postgres
DATABASE_SSL=true

# JWT auth (min 32 characters for JWT_SECRET)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Supabase (service role for API — or use DATABASE_URL only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Organization
ORG_ID=
NEXT_PUBLIC_ORG_SLUG=demo

# CORS — comma-separated production/extra origins (no trailing slashes)
CORS_ORIGINS=https://demo.madsoul.in,https://nyleader.vercel.app,http://localhost:5173,http://localhost:3000,http://localhost:8080
# Allow any localhost port (local dev → remote API)
ALLOW_LOCALHOST_CORS=true
# Allow any https://*.vercel.app (Vercel preview + production)
ALLOW_VERCEL_CORS=true

# Local dev: impersonate a user without JWT when NODE_ENV=development
# DEV_BYPASS_AUTH=false
# DEV_USER_ID=

# Local dev: pin all ticket offers to one ground worker (default Sanjay Gupta). Off in production.
# DEV_OFFER_WORKER_PIN=false
# DEV_OFFER_WORKER_NAME=Sanjay Gupta
# DEV_OFFER_WORKER_ID=

PORT=3001

# Staff profile/KYC + ticket attachment presigned uploads (S3). Required for direct ticket uploads when DATABASE_URL is set.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STAFF_STORAGE_BUCKET=staff-documents

# Staff OTP delivery — third-party providers
# OTP_DELIVERY_MODE=console  → log codes to API console (local / CI / test)
# OTP_DELIVERY_MODE=live     → AWS SES (email) + Twilio (SMS) — use in staging/production
# Default: console in NODE_ENV=development, live otherwise
OTP_DELIVERY_MODE=console
OTP_CHANNEL_PREFERENCE=sms_first
# sms | email | sms,email — use OTP_CHANNELS=sms when you only have Twilio (no SES/domain)
OTP_CHANNELS=sms,email
OTP_APP_NAME=Vocal
OTP_TTL_MINUTES=10
# Return dev_code in API response when using console mode (Sign-in UI shows it)
OTP_EXPOSE_DEV_CODE=true

# AWS SES (email OTP) — verify sender/domain in SES console (optional if OTP_CHANNELS=sms)
# Use AWS_SES_REGION when SES identity is in a different region than S3 (AWS_REGION)
AWS_SES_REGION=ap-south-2
AWS_SES_FROM_EMAIL=no-reply@my-leader.in

# Twilio SMS (phone OTP) — use ONE of TWILIO_SMS_FROM or TWILIO_MESSAGING_SERVICE_SID
# TWILIO_SMS_FROM must be a number listed under YOUR account in Twilio Console → Phone Numbers
# Do NOT use +14155238886 (Twilio WhatsApp sandbox) unless that number is on your account
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+14155551234
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx

# WhatsApp citizen intake (Twilio webhook)
 TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
 TWILIO_SKIP_SIGNATURE_VALIDATION=true
 WHATSAPP_INTAKE_MODE=ai   # ai (default) | script — script = numbered menu flow
 OPENROUTER_API_KEY=        # required for AI chat on WhatsApp
 OPENROUTER_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# Bharosa (citizen grievance → authority resolution)
# ---------------------------------------------------------------------------

# Public URLs: PUBLIC_APP_URL builds case links in citizen WhatsApp/SMS updates;
# PUBLIC_API_BASE_URL builds the voice-agent callback URL.
PUBLIC_APP_URL=https://bharosa.my-leader.in
PUBLIC_API_BASE_URL=https://api.my-leader.in

# Citizen login (OTP to mobile). OTP_DELIVERY_MODE / OTP_EXPOSE_DEV_CODE above also apply.
CITIZEN_JWT_EXPIRES_IN=30d
CITIZEN_OTP_APP_NAME=Bharosa
# twilio (default) | exotel — Exotel is needed for DLT-compliant SMS in India
OTP_SMS_PROVIDER=twilio

# Exotel SMS (DLT). Templates must match the DLT-approved text exactly.
# EXOTEL_OTP_TEMPLATE placeholders: {code} {app} {ttl}
# EXOTEL_UPDATE_TEMPLATE placeholders: {ref} {status} {link} {app}
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SUBDOMAIN=api.exotel.com
# EXOTEL_SENDER_ID=
# EXOTEL_DLT_ENTITY_ID=
# EXOTEL_DLT_OTP_TEMPLATE_ID=
# EXOTEL_OTP_TEMPLATE=
# EXOTEL_DLT_UPDATE_TEMPLATE_ID=
# EXOTEL_UPDATE_TEMPLATE=
# EXOTEL_SMS_STATUS_CALLBACK_URL=

# Citizen WhatsApp status updates (Twilio content templates; vars 1=ref 2=text 3=status 4=link).
# Without a template SID, free-form text is sent (works only inside the 24h session window).
# BHAROSA_WA_UPDATE_TEMPLATE_SID=
# BHAROSA_WA_UPDATE_TEMPLATE_SID_TE=
# BHAROSA_WA_UPDATE_TEMPLATE_SID_EN=

# Authority email. console = log only (default in development) | live = AWS SES
EMAIL_DELIVERY_MODE=console
BHAROSA_EMAIL_FROM=grievances@my-leader.in
# Replies come back to <local>+<thread>@<domain>; configure SES inbound (receipt rule → SNS) for this domain
BHAROSA_INBOUND_EMAIL_DOMAIN=reply.my-leader.in
BHAROSA_INBOUND_EMAIL_LOCAL=case
# Citizens email new complaints to <local>@<inbound domain> (default org = ORG_ID) or <local>-<org-slug>@<inbound domain>
BHAROSA_INTAKE_EMAIL_LOCAL=complaints
# SES configuration set publishing delivery/bounce/complaint events to SNS → POST /webhooks/bharosa/ses
# SES_CONFIGURATION_SET=bharosa-events
SNS_ALLOWED_TOPIC_ARNS=
SNS_SKIP_SIGNATURE_VALIDATION=false
# Shared secret for the generic inbound-email webhook (header X-Bharosa-Secret) — POST /webhooks/bharosa/inbound-email
BHAROSA_INBOUND_WEBHOOK_SECRET=

# AI agents (OpenRouter). Every agent falls back to deterministic templates if AI is unavailable.
# Per-agent override: BHAROSA_MODEL_<AGENT> where AGENT is STRUCTURING | ROUTING | RESOLUTION |
# CONTENT | RESPONSE_SUMMARY | VERIFICATION_CALL | TRANSLATION
# BHAROSA_MODEL=google/gemini-2.5-flash
# BHAROSA_MODEL_TRANSLATION=

# Automated verification call (optional). Without a provider URL, calls become manual tasks with an AI script.
# Provider POSTs results to {PUBLIC_API_BASE_URL}/webhooks/bharosa/voice/:checkId?token=...
# VOICE_AGENT_PROVIDER=
# VOICE_AGENT_PROVIDER_URL=
# VOICE_AGENT_API_KEY=
# VOICE_AGENT_CALLBACK_SECRET=

# Background jobs (Postgres queue). Run the worker in exactly the processes you want.
JOBS_WORKER_ENABLED=true
JOBS_SCHEDULER_ENABLED=true
JOBS_CONCURRENCY=4
JOBS_POLL_MS=1000
